# NurBuy Minutes: page addresses (/p/..., /c/..., /shop/..., /orders/...) open index.php,
# which sends index.html with the right title and link-preview tags.
DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>
# always load a fresh page; assets carry ?v=<build>
<IfModule mod_headers.c>
<FilesMatch "\.(html|php|txt|webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "^sw\.js$">
Header set Cache-Control "no-cache"
Header set Service-Worker-Allowed "/"
</FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
