# NurBuy API environment. Copy this file to ".env" (same folder as config.php) on the server
# and put your real key after the equals sign. Never commit ".env".
# Maps JavaScript API key (restricted by HTTP referrer: minutes / seller / rider.nurbuy.com + localhost).
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID if you later style the map in Google Cloud (leave empty otherwise).
GOOGLE_MAPS_MAP_ID=
