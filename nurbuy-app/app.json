{
  "expo": {
    "name": "NurBuy",
    "slug": "nurbuy-minutes",
    "scheme": "nurbuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "com.nurbuy.minutes",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nurbuy.minutes",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F3F3F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-status-bar", { "style": "dark", "hidden": false }],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1d2fe0",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NurBuy uses the microphone only to record voice messages you send to support.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NurBuy uses the camera to find products from a photo and to send photos to support.",
          "photosPermission": "NurBuy uses your photos to find products, set your profile picture and send photos to support."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "129b3f9e-ec28-476c-b533-55b0c160ccfa"
      }
    },
    "owner": "nurbuy"
  }
}
