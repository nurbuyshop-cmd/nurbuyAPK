 /* =====================================================================
+ * Customer app: phone push through Firebase Cloud Messaging (HTTP v1).
+ * FCM only carries the message; the notification itself is the user_notif row above.
+ * config.php: 'fcm_service_account' => '/home/USER/private/firebase-service-account.json'
+ *             (path outside the web root; the JSON array itself also works). Never commit the file.
+ * ===================================================================== */
+
+/** POST /me/device {token, platform}: the app registers its push token after login. */
+function h_me_device_add() {
+    $u = require_user();
+    $b = body_json();
+    $tok = isset($b['token']) && is_string($b['token']) ? trim($b['token']) : '';
+    $pf = isset($b['platform']) && in_array($b['platform'], ['android', 'ios'], true) ? $b['platform'] : 'android';
+    if ($tok === '' || strlen($tok) > 4096 || !preg_match('/^[A-Za-z0-9_:\-\.]+$/', $tok)) fail(400, 'Invalid device token', 'token');
+    $h = hash('sha256', $tok); $t = now_ts();
+    // one phone = one token; if another account signs in on it, the phone moves to that account
+    if (db_val('SELECT 1 FROM device_tokens WHERE token_hash=?', [$h])) q('UPDATE device_tokens SET user_id=?, platform=?, updated_at=? WHERE token_hash=?', [$u['id'], $pf, $t, $h]);
+    else {
+        try { q('INSERT INTO device_tokens (user_id, token, token_hash, platform, created_at, updated_at) VALUES (?,?,?,?,?,?)', [$u['id'], $tok, $h, $pf, $t, $t]); }
+        catch (PDOException $e) { if (!is_unique_violation($e)) throw $e; }
+        // keep the newest 10 phones per customer
+        $ids = array_column(db_rows('SELECT id FROM device_tokens WHERE user_id=? ORDER BY updated_at DESC, id DESC', [$u['id']]), 'id');
+        if (count($ids) > 10) q('DELETE FROM device_tokens WHERE id IN (' . implode(',', array_map('intval', array_slice($ids, 10))) . ')');
+    }
+    json_out(['ok' => true]);
+}
+/** DELETE /me/device {token}: the app removes its token on logout. */
+function h_me_device_del() {
+    $u = require_user();
+    $b = body_json();
+    $tok = isset($b['token']) && is_string($b['token']) ? trim($b['token']) : '';
+    if ($tok !== '') q('DELETE FROM device_tokens WHERE token_hash=? AND user_id=?', [hash('sha256', $tok), $u['id']]);
+    json_out(['ok' => true]);
+}
+
+/** Service account from config (file path or array); null when phone push is not set up. */
+function fcm_account() {
+    static $a = false;
+    if ($a !== false) return $a;
+    $c = cfg('fcm_service_account', null);
+    if (is_string($c) && $c !== '' && is_file($c)) $c = json_decode((string)@file_get_contents($c), true);
+    $a = (is_array($c) && !empty($c['project_id']) && !empty($c['client_email']) && !empty($c['private_key'])) ? $c : null;
+    return $a;
+}
+/** OAuth access token for FCM (signed JWT grant), cached in kv for 50 minutes. */
+function fcm_access_token() {
+    $acc = fcm_account();
+    if (!$acc) return null;
+    $row = kv_get('fcm_token');
+    if ($row) { $j = json_decode((string)$row['v'], true); if (is_array($j) && !empty($j['t']) && (int)($j['exp'] ?? 0) > now_ts() + 60) return $j['t']; }
+    $now = now_ts();
+    $h = b64u_enc(json_encode(['alg' => 'RS256', 'typ' => 'JWT']));
+    $c = b64u_enc(json_encode(['iss' => $acc['client_email'], 'scope' => 'https://www.googleapis.com/auth/firebase.messaging',
+                               'aud' => 'https://oauth2.googleapis.com/token', 'iat' => $now, 'exp' => $now + 3600], JSON_UNESCAPED_SLASHES));
+    $sig = '';
+    if (!openssl_sign($h . '.' . $c, $sig, $acc['private_key'], OPENSSL_ALGO_SHA256)) { error_log('fcm: sign failed'); return null; }
+    $ch = curl_init('https://oauth2.googleapis.com/token');
+    curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 8, CURLOPT_CONNECTTIMEOUT => 4,
+        CURLOPT_POSTFIELDS => http_build_query(['grant_type' => 'urn:ietf:params:oauth:grant-type:jwt-bearer', 'assertion' => $h . '.' . $c . '.' . b64u_enc($sig)])]);
+    $res = json_decode((string)curl_exec($ch), true);
+    curl_close($ch);
+    if (!is_array($res) || empty($res['access_token'])) { error_log('fcm: no access token'); return null; }
+    kv_set('fcm_token', json_encode(['t' => $res['access_token'], 'exp' => $now + min(3000, (int)($res['expires_in'] ?? 3600))]));
+    return $res['access_token'];
+}
+/** Collects phone messages during the request; they are sent after the response, like Web Push. */
+function fcm_enqueue($userId, $payload) {
+    static $q = null;
+    if (!fcm_account() || !function_exists('curl_init')) return;
+    try {
+        $toks = db_rows('SELECT id, token FROM device_tokens WHERE user_id=?', [$userId]);
+    } catch (Throwable $e) { return; } // table not created yet
+    if (!$toks) return;
+    if ($q === null) {
+        $q = [];
+        register_shutdown_function(function () use (&$q) {
+            if (function_exists('fastcgi_finish_request')) @fastcgi_finish_request();
+            foreach ($q as $m) fcm_send($m[0], $m[1], $m[2]);
+        });
+    }
+    foreach ($toks as $t) $q[] = [(int)$t['id'], $t['token'], $payload];
+}
+/** One FCM message. A token Google no longer knows is deleted. */
+function fcm_send($rowId, $token, $p) {
+    try {
+        $acc = fcm_account(); $at = fcm_access_token();
+        if (!$acc || !$at) return;
+        $n = ['title' => (string)($p['title'] ?? ''), 'body' => (string)($p['body'] ?? '')];
+        if (!empty($p['img'])) $n['image'] = (string)$p['img'];
+        $msg = ['message' => ['token' => $token, 'notification' => $n,
+            // the app opens this link when the notification is tapped (relative paths like /orders/NBM-1)
+            'data' => ['url' => (string)($p['url'] ?? '/'), 'id' => (string)($p['id'] ?? ''), 'kind' => (string)($p['tag'] ?? '')],
+            'android' => ['priority' => 'high', 'notification' => ['channel_id' => 'default', 'tag' => (string)($p['id'] ?? 'nb')]]]];
+        $ch = curl_init('https://fcm.googleapis.com/v1/projects/' . rawurlencode($acc['project_id']) . '/messages:send');
+        curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 8, CURLOPT_CONNECTTIMEOUT => 4,
+            CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'Authorization: Bearer ' . $at],
+            CURLOPT_POSTFIELDS => json_encode($msg, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)]);
+        $res = (string)curl_exec($ch);
+        $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
+        curl_close($ch);
+        if ($code === 404 || ($code === 400 && strpos($res, 'INVALID_ARGUMENT') !== false && strpos($res, 'token') !== false) || strpos($res, 'UNREGISTERED') !== false)
+            q('DELETE FROM device_tokens WHERE id=?', [$rowId]);
+        elseif ($code === 401) q("DELETE FROM kv WHERE k='fcm_token'"); // expired access token: fetch a new one next time
+        elseif ($code < 200 || $code >= 300) error_log('fcm_send: HTTP ' . $code . ' ' . substr($res, 0, 300));
+    } catch (Throwable $e) { error_log('fcm_send: ' . $e->getMessage()); }
+}
